<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
    <PackageReference Include="Sentry.Serilog" Version="6.11.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\docs\testimonials.json" Link="testimonials.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\docs\sss.md" Link="sss.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HerYerde.Business\HerYerde.Business.csproj" />
    <ProjectReference Include="..\HerYerde.DataAccess\HerYerde.DataAccess.csproj" />
    <ProjectReference Include="..\HerYerde.Entities\HerYerde.Entities.csproj" />
    <ProjectReference Include="..\HerYerde.Core\HerYerde.Core.csproj" />
  </ItemGroup>

</Project>
