@using HerYerde.Entities.Enums
@using HerYerde.Web.Models
@model CheckoutPageViewModel
@{
    ViewData["Title"] = "Ödeme";
    var cart = Model.Cart;
    var havale = Model.Form.PaymentMethod == PaymentMethod.HavaleEft;
    var kart = Model.CardEnabled && Model.Form.PaymentMethod == PaymentMethod.KrediKarti;
    var couponMessage = TempData[HerYerde.Web.Controllers.CartController.CouponKey] as string ?? cart.CouponProblem;
    var couponBox = new CouponBoxViewModel(cart.CouponCode, "/odeme", couponMessage);
}

<div class="container section">
    <h1 class="display-2 h-mark">Ödeme</h1>
    <p class="lead">@(Model.CardEnabled
        ? "Kartla 3D Secure ile ödeyin, kapıda ödeyin ya da havale/EFT ile gönderin."
        : "Kart bilgisi istemiyoruz: kapıda ödeyin ya da havale/EFT ile gönderin.")</p>

    @if (Model.Notice is not null)
    {
        <p class="form-alert form-alert--notice" role="status">@Model.Notice</p>
    }

    @if (Model.ErrorMessage is not null)
    {
        <p class="form-alert" role="alert">@Model.ErrorMessage</p>
    }

    <div class="checkout">
        <form class="checkout__form form-card" method="post" action="/odeme">
            @Html.AntiForgeryToken()

            <partial name="_CustomerFields" model="Model.Form" />

            <fieldset class="pay" data-pay>
                <legend class="pay__legend">Ödeme yöntemi</legend>

                <input class="pay__input" type="radio" id="pay-kapida" name="PaymentMethod"
                       value="@((int)PaymentMethod.KapidaOdeme)" checked="@(!havale && !kart)" />
                <label class="pay__option" for="pay-kapida">
                    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                    <span>
                        <span class="pay__title">Kapıda ödeme</span>
                        <span class="pay__note">Kurye geldiğinde nakit ya da kartla ödersiniz.</span>
                    </span>
                </label>

                <input class="pay__input" type="radio" id="pay-havale" name="PaymentMethod"
                       value="@((int)PaymentMethod.HavaleEft)" checked="@havale" />
                <label class="pay__option" for="pay-havale">
                    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 22h18"/><path d="M6 18v-7"/><path d="M10 18v-7"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="m12 2 10 6H2z"/></svg>
                    <span>
                        <span class="pay__title">Havale / EFT</span>
                        <span class="pay__note">Ödemeniz hesaba geçtiğinde kargoya veriyoruz.</span>
                    </span>
                </label>

                @if (Model.CardEnabled)
                {
                    <input class="pay__input" type="radio" id="pay-kart" name="PaymentMethod"
                           value="@((int)PaymentMethod.KrediKarti)" checked="@kart" />
                    <label class="pay__option" for="pay-kart">
                        <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/></svg>
                        <span>
                            <span class="pay__title">Kredi / banka kartı</span>
                            <span class="pay__note">Bankanızın 3D Secure onayıyla ödersiniz; e-posta gerekir, kart bilginiz bizde saklanmaz.</span>
                        </span>
                    </label>

                    @* Kart alanları sayfaya geri yazılmaz: hata olursa boş gelir. required yok; gizliyken formu kilitlemesin. *@
                    <div class="card-box" data-card hidden="@(!kart)">
                        <div class="field">
                            <label class="field__label" for="card-holder">Kart üzerindeki ad</label>
                            <input class="field__input" id="card-holder" name="CardHolderName" autocomplete="cc-name" maxlength="100" />
                            @Html.ValidationMessage("CardHolderName", null, new { @class = "field__error" })
                        </div>
                        <div class="field">
                            <label class="field__label" for="card-number">Kart numarası</label>
                            <input class="field__input field__input--mono" id="card-number" name="CardNumber" inputmode="numeric" autocomplete="cc-number" maxlength="23" placeholder="0000 0000 0000 0000" />
                            @Html.ValidationMessage("CardNumber", null, new { @class = "field__error" })
                        </div>
                        <div class="field-row">
                            <div class="field">
                                <label class="field__label" for="card-month">Son kullanma ayı</label>
                                <input class="field__input field__input--mono" id="card-month" name="CardExpireMonth" inputmode="numeric" autocomplete="cc-exp-month" maxlength="2" placeholder="AA" />
                            </div>
                            <div class="field">
                                <label class="field__label" for="card-year">Yılı</label>
                                <input class="field__input field__input--mono" id="card-year" name="CardExpireYear" inputmode="numeric" autocomplete="cc-exp-year" maxlength="4" placeholder="YY" />
                            </div>
                            <div class="field">
                                <label class="field__label" for="card-cvc">Güvenlik kodu</label>
                                <input class="field__input field__input--mono" id="card-cvc" name="CardCvc" inputmode="numeric" autocomplete="cc-csc" maxlength="4" placeholder="CVC" />
                            </div>
                        </div>
                        @Html.ValidationMessage("CardExpireMonth", null, new { @class = "field__error" })
                        @Html.ValidationMessage("CardCvc", null, new { @class = "field__error" })
                        @if (Model.InstallmentsEnabled)
                        {
                            @* Kart numarasının ilk 6 hanesi girilince site.js buraya bankanın taksit tablosunu yazar. *@
                            <div data-installments aria-live="polite"></div>
                        }
                        <p class="card-box__note">
                            <svg class="icon icon--sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            <span>Siparişi tamamlayınca bankanızın doğrulama sayfası açılır; çekim onaydan sonra yapılır.</span>
                        </p>
                    </div>
                }

                <div class="iban" data-iban hidden="@(!havale)">
                    <span class="iban__code" data-iban-value>@Model.Iban</span>
                    <button class="btn btn--ghost btn--sm" type="button" data-iban-copy>
                        <svg class="icon icon--sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16V4a2 2 0 0 1 2-2h10"/></svg>
                        <span>IBAN'ı kopyala</span>
                    </button>
                    <span class="iban__done" data-iban-done hidden role="status">Kopyalandı</span>
                </div>
                @Html.ValidationMessage("PaymentMethod", null, new { @class = "field__error" })
            </fieldset>

            <div class="field">
                <label class="switch">
                    <input type="checkbox" name="LegalConsent" value="true" required checked="@Model.Form.LegalConsent" />
                    <span>
                        <a href="/yasal/on-bilgilendirme-formu" target="_blank" rel="noopener">Ön bilgilendirme formunu</a> ve
                        <a href="/yasal/mesafeli-satis-sozlesmesi" target="_blank" rel="noopener">mesafeli satış sözleşmesini</a>
                        okudum, kabul ediyorum.
                    </span>
                </label>
                @Html.ValidationMessage("LegalConsent", null, new { @class = "field__error" })
            </div>

            <div class="form-card__foot">
                <a class="btn btn--ghost" href="/sepet">Sepete dön</a>
                <button class="btn btn--cta btn--lg" type="submit">Siparişi tamamla</button>
            </div>
        </form>

        <aside class="checkout__aside" aria-label="Sipariş özeti">
            <div class="summary">
                <h2 class="heading-3">Siparişiniz</h2>
                @foreach (var line in cart.Lines)
                {
                    <partial name="Components/_CartLine" model="new CartLineViewModel(line, false)" />
                }
                @foreach (var gift in cart.GiftLines)
                {
                    <p class="summary__row summary__row--gift">
                        <span><span class="tag tag--gift">Hediye</span> @gift.ProductName × @gift.Quantity</span>
                        <span class="summary__value">0,00 ₺</span>
                    </p>
                }
                @if (cart.GiftNote is not null)
                {
                    <p class="summary__note" role="status">@cart.GiftNote</p>
                }
                <p class="summary__row">
                    <span>Ara toplam</span>
                    <span class="summary__value">@Money.Tl(cart.Subtotal)</span>
                </p>
                <p class="summary__row">
                    <span>Kargo</span>
                    <span class="summary__value">@(cart.FreeShipping ? "Kargo bedava" : Money.Tl(cart.ShippingFee))</span>
                </p>
                @if (cart.Discount > 0m)
                {
                    <p class="summary__row summary__row--discount">
                        <span>İndirim<span class="tag tag--gift">@cart.CouponCode</span></span>
                        <span class="summary__value">−@Money.Tl(cart.Discount)</span>
                    </p>
                }
                <partial name="Components/_FreeShipping" model="new OrderSummaryViewModel(cart.Subtotal, cart.ShippingFee, cart.Total, null, cart.FreeShippingOver)" />
                <p class="summary__row summary__row--total">
                    <span>Toplam</span>
                    <span class="summary__value">@Money.Tl(cart.Total)</span>
                </p>
                @if (!cart.FreeShipping)
                {
                    <p class="summary__note">Kargo ücreti alıcıya aittir.</p>
                }
            </div>
            <partial name="Components/_CouponBox" model="couponBox" />
        </aside>
    </div>
</div>
