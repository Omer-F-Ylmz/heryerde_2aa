@using HerYerde.Business.Rules
@using HerYerde.Entities.Enums
@using HerYerde.Web.Models
@model ThankYouViewModel
@{
    var order = Model.Detail.Order;
    ViewData["Title"] = order.OrderNo + " siparişi";
    var havale = order.PaymentMethod == PaymentMethod.HavaleEft;
}

<div class="container section">
    <div class="thanks">
        <div>
            <p class="eyebrow">Siparişiniz alındı</p>
            <h1 class="display-2 h-mark">Teşekkürler @order.FullName</h1>
            <p class="thanks__no">
                <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                @order.OrderNo
            </p>
        </div>

        <div class="thanks__card">
            <h2 class="heading-3">Sipariş durumu</h2>
            <partial name="Components/_StatusSteps" model="order.Status" />
        </div>

        <div class="thanks__card">
            <h2 class="heading-3">Sipariş özeti</h2>
            @foreach (var item in Model.Detail.Items)
            {
                <p class="summary__row">
                    <span>@item.ProductName × @item.Quantity</span>
                    <span class="summary__value">@Money.Tl(item.UnitPrice * item.Quantity)</span>
                </p>
            }
            <p class="summary__row">
                <span>Kargo</span>
                <span class="summary__value">@(order.ShippingFee == 0m ? "Kargo bedava" : Money.Tl(order.ShippingFee))</span>
            </p>
            <p class="summary__row summary__row--total">
                <span>Toplam</span>
                <span class="summary__value">@Money.Tl(order.Total)</span>
            </p>
            <p class="summary__note">
                <partial name="Components/_StatusPill" model="order.Status" />
                @PaymentLabels.Method(order.PaymentMethod)@(Model.Detail.Payment is { } payment ? " · " + PaymentLabels.Status(payment.Status) : "") · @order.District, @order.City
            </p>
        </div>

        @if (havale)
        {
            <div class="thanks__card">
                <h2 class="heading-3">Havale bilgileri</h2>
                <p>Açıklamaya sipariş numaranızı yazın; ödeme görüldüğünde kargoya veriyoruz.</p>
                <div class="iban">
                    <span class="iban__code" data-iban-value>@Model.Iban</span>
                    <button class="btn btn--ghost btn--sm" type="button" data-iban-copy>
                        <svg class="icon icon--sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16V4a2 2 0 0 1 2-2h10"/></svg>
                        <span>IBAN'ı kopyala</span>
                    </button>
                    <span class="iban__done" data-iban-done hidden role="status">Kopyalandı</span>
                </div>
            </div>
        }

        @if (order.Carrier is { } carrier)
        {
            <div class="thanks__card">
                <h2 class="heading-3">Kargo takibi</h2>
                <p class="summary__row">
                    <span>@carrier</span>
                    <span class="summary__value">@order.TrackingNo</span>
                </p>
                @if (Model.TrackingUrl is { } tracking)
                {
                    <p>
                        <a class="btn btn--secondary" href="@tracking" rel="noopener" target="_blank">
                            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5v8h2"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                            <span>Kargomu takip et</span>
                        </a>
                    </p>
                }
            </div>
        }

        <div>
            <h2 class="heading-3">Bundan sonrası</h2>
            <ol class="thanks__steps">
                <li>@order.Phone numarasından sizi arayıp siparişi teyit ediyoruz.</li>
                <li>@(havale ? "Ödeme hesabımıza geçtiğinde kargoya veriyoruz." : "Kargoya verip takip bilgisini paylaşıyoruz.")</li>
                <li>@(order.ShippingFee == 0m ? "Bu siparişin kargosu bizden." : "Kargo ücreti alıcıya aittir.")</li>
            </ol>
            <p>
                <a class="btn btn--cta btn--lg" href="@Model.WhatsAppUrl" rel="noopener">
                    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                    WhatsApp'tan siparişimi bildir
                </a>
            </p>
            @if (order.LegalVersion is { } version)
            {
                <p class="summary__note">
                    Siparişiniz <a href="/yasal/on-bilgilendirme-formu">ön bilgilendirme formu</a> ve
                    <a href="/yasal/mesafeli-satis-sozlesmesi">mesafeli satış sözleşmesi</a> (sürüm @version) kapsamındadır.
                </p>
            }
        </div>
    </div>
</div>
