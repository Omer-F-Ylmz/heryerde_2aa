@using HerYerde.Web.Models
@model OrderSummaryViewModel
@if (Model.ShowProgress)
{
    <div class="freeship" data-free-shipping-progress="@Model.Progress">
        @if (Model.FreeShipping)
        {
            <p class="freeship__text freeship__text--done">
                <svg class="icon icon--sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                Kargo bedava, bu sipariş bizden gelir.
            </p>
        }
        else
        {
            <p class="freeship__text">@Money.Tl(Model.ToFreeShipping) daha ekleyin, kargo bizden.</p>
        }
        <div class="freeship__track"
             role="progressbar"
             aria-valuenow="@Model.Progress"
             aria-valuemin="0"
             aria-valuemax="100"
             aria-label="Bedava kargoya ilerleme">
            <span class="freeship__fill freeship__fill--@Model.ProgressStep"></span>
        </div>
    </div>
}
