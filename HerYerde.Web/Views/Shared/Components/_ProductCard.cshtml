@using HerYerde.Web.Models
@model ProductCardVm
@{
    var srcset = ProductImages.Srcset(Model.ImageUrl);
    var secondSrcset = ProductImages.Srcset(Model.SecondImageUrl);
}
<article class="card">
    @* Önizleme adresi yalnız veri: oynatıcıyı site.js kurar, azaltılmış harekette hiç kurmaz. Razor data-* özniteliğini
       değer null olsa da yazar; videosuz kartta boş öznitelik kalmasın diye işaret ayrı ve koşullu. *@
    @if (Model.PreviewUrl is not null)
    {
        <template data-onizleme="@Model.PreviewUrl"></template>
    }
    <a class="card__media" href="@Model.Url" tabindex="-1" aria-hidden="true">
        @if (Model.ImageUrl is null)
        {
            <span class="ph@(Model.PlaceholderIcon is null ? "" : " ph--" + Model.PlaceholderIcon)"></span>
        }
        else
        {
            <img src="@Model.ImageUrl" srcset="@srcset" sizes="@(srcset is null ? null : ProductImages.CardSizes)" alt="" width="600" height="600" loading="@(Model.Lazy ? "lazy" : "eager")" />
            @if (Model.SecondImageUrl is not null)
            {
                <img class="card__alt" src="@Model.SecondImageUrl" srcset="@secondSrcset" sizes="@(secondSrcset is null ? null : ProductImages.CardSizes)" alt="" width="600" height="600" loading="lazy" />
            }
        }
        @if (Model.Badge is not null)
        {
            <partial name="Components/_Badge" model="Model.Badge" />
        }
    </a>
    <div class="card__body">
        <h3 class="card__title"><a href="@Model.Url">@Model.Name</a></h3>
        <partial name="Components/_PriceBlock" model="new PriceBlockVm(Model.Price, Model.CampaignPrice)" />
    </div>
</article>
