@using HerYerde.Web.Models
@model OrderSummaryViewModel
<div class="summary">
    <h2 class="heading-3">Özet</h2>
    <p class="summary__row">
        <span>Ara toplam</span>
        <span class="summary__value">@Money.Tl(Model.Subtotal)</span>
    </p>
    <p class="summary__row">
        <span>Kargo</span>
        <span class="summary__value">@(Model.FreeShipping ? "Kargo bedava" : Money.Tl(Model.ShippingFee))</span>
    </p>
    @if (Model.Discount > 0m)
    {
        <p class="summary__row summary__row--discount">
            <span>İndirim<span class="tag tag--gift">@Model.CouponCode</span></span>
            <span class="summary__value">−@Money.Tl(Model.Discount)</span>
        </p>
    }
    <partial name="Components/_FreeShipping" model="Model" />
    <p class="summary__row summary__row--total">
        <span>Toplam</span>
        <span class="summary__value">@Money.Tl(Model.Total)</span>
    </p>
    @if (Model.Note is not null)
    {
        <p class="summary__note">@Model.Note</p>
    }
</div>
