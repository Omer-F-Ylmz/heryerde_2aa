@using HerYerde.Web.Models
@model IReadOnlyList<SuggestionVm>
@* /ara/oner parçası: başlıktaki kutunun altına site.js yerleştirir. Öneri yoksa boş gövde. *@
@if (Model.Count > 0)
{
    <ul class="suggest__list">
        @foreach (var suggestion in Model)
        {
            <li>
                <a class="suggest__item" href="@suggestion.Url">
                    <span class="suggest__name">@suggestion.Name</span>
                    <span class="suggest__note">@suggestion.Note</span>
                </a>
            </li>
        }
    </ul>
}
