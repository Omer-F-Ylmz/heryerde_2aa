<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? $"{t} · HerYerde" : "HerYerde")</title>
    <meta name="description" content="HerYerde — şalvardan sofraya, giyim ve ev ürünleri. Yakında." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600&family=Lora:wght@600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="surface-base">
    <header class="site-header">
        <a class="wordmark" href="/" aria-label="HerYerde ana sayfa">HerYerde</a>
        <span class="site-header__meta">Giyim &amp; Ev</span>
    </header>
    <main id="main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <span>HerYerde, @DateTime.UtcNow.Year</span>
        <span class="site-footer__note">Kapıda ödeme &amp; havale/EFT</span>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
