@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject HerYerde.Business.Abstract.ICartService CartService
@inject Microsoft.Extensions.Options.IOptions<HerYerde.Business.ShopSettings> Shop
@inject Microsoft.Extensions.Options.IOptions<HerYerde.Business.IyzicoSettings> Iyzico
@inject HerYerde.Business.Abstract.IAnnouncementService Announcements
@using HerYerde.Web.Models
@{
    // Hata sayfası veritabanı düşmüşken de çizilebilsin diye sepet rozetini ve duyuruyu sormaz.
    var cartCount = ViewData["SkipCart"] is true ? 0 : await HerYerde.Web.Infrastructure.CartBadge.CountAsync(Context, CartService);
    var announcement = ViewData["SkipCart"] is true ? null : await Announcements.CurrentAsync(Context.RequestAborted);
    var title = ViewData["Title"] as string;
    var description = ViewData["Description"] as string ?? "HerYerde — çeyizden mutfağa ev ürünleri; kapıda ödeme, WhatsApp'tan sipariş.";
    var canonical = ViewData["Canonical"] is string path ? Seo.Absolute(Shop.Value.BaseUrl, path) : null;
    // Kendi görseli olmayan sayfa paylaşımda marka kartını (og-default.png) gösterir.
    var image = Seo.Absolute(Shop.Value.BaseUrl, ViewData["OgImage"] as string ?? "/og-default.png");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(title is not null ? $"{title} · HerYerde" : "HerYerde")</title>
    <meta name="description" content="@description" />
    @if (ViewData["Robots"] is string robots)
    {
        <meta name="robots" content="@robots" />
    }
    @if (canonical is not null)
    {
        <link rel="canonical" href="@canonical" />
    }
    <meta property="og:site_name" content="HerYerde" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content="@(title ?? "HerYerde")" />
    <meta property="og:description" content="@description" />
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    @if (canonical is not null)
    {
        <meta property="og:url" content="@canonical" />
    }
    <meta property="og:image" content="@image" />
    @if (Config["Seo:GoogleVerification"] is { Length: > 0 } verification)
    {
        <meta name="google-site-verification" content="@verification" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(title ?? "HerYerde")" />
    <meta name="twitter:description" content="@description" />
    @if (ViewData["JsonLd"] is IEnumerable<string> blocks)
    {
        // Veri bloğu çalıştırılmaz; CSP script-src kısıtı buna uygulanmaz, 'unsafe-inline' gerekmez.
        // "!" script tag helper'ını kapatır; yoksa type değerindeki "+" &#x2B; olarak yazılır.
        foreach (var block in blocks)
        {
            <!script type="application/ld+json">@Html.Raw(block)</!script>
        }
    }
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#A8442A" />
    <link rel="preload" href="~/fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/lora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="surface-base">
    @if (announcement is not null)
    {
        @* Çerezsiz kapatma: site.js şeridi yalnız oturum boyunca (sessionStorage) gizler. *@
        <aside class="announcement announcement--@(announcement.Color == HerYerde.Entities.Enums.AnnouncementColor.Yesil ? "yesil" : "kiremit")"
               data-announcement="@announcement.Id" aria-label="Duyuru">
            @if (announcement.Url is { Length: > 0 } announcementUrl)
            {
                <a class="announcement__text" href="@announcementUrl">@announcement.Text</a>
            }
            else
            {
                <span class="announcement__text">@announcement.Text</span>
            }
            <button class="announcement__close" type="button" data-announcement-close hidden aria-label="Duyuruyu kapat">
                <svg class="icon icon--sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </aside>
    }
    <header class="store-header">
        <a class="wordmark" href="/" aria-label="HerYerde ana sayfa">HerYerde</a>
        <nav class="store-nav" aria-label="Alanlar">
            <a class="store-nav__link" href="/ev">Ev</a>
            <a class="store-nav__link" href="/ortu">Örtü &amp; Eşarp</a>
        </nav>
        <form class="search" method="get" action="/ara" role="search" data-no-csrf>
            <label class="visually-hidden" for="site-search">Ürün ara</label>
            <input class="field__input" id="site-search" name="q" type="search" maxlength="60"
                   placeholder="Ürün ara" value="@(Context.Request.Query["q"])" data-suggest />
            <button class="icon-btn" type="submit" aria-label="Ara">
                <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </button>
        </form>
        <div class="store-header__actions">
            @* Hesap simgesi çerezdeki kimliğe bakar, sorgu yapmaz; ad yazılmaz (vitrin sayfaları cihazda çevrimdışı yedeklenir). *@
            @if (HerYerde.Web.Infrastructure.CustomerPolicy.CustomerId(Context.User) is null)
            {
                <a class="icon-btn" href="/hesap/giris" aria-label="Giriş yap ya da üye ol">
                    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
                </a>
            }
            else
            {
                <a class="icon-btn icon-btn--account" href="/hesap" aria-label="Hesabım">
                    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
                    <span class="account-dot" aria-hidden="true"></span>
                </a>
            }
            <a class="icon-btn icon-btn--cart" href="/sepet" aria-label="Sepet@(cartCount > 0 ? $", {cartCount} ürün" : ", boş")">
                <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                @if (cartCount > 0)
                {
                    <span class="cart-badge" aria-hidden="true">@cartCount</span>
                }
            </a>
        </div>
    </header>
    <main id="main" class="store-main">
        @RenderBody()
    </main>
    <footer class="store-footer">
        <div class="store-footer__links">
            <a class="footer-link" href="@Config["Shop:WhatsApp"]" rel="noopener" data-event="whatsapp">
                <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                WhatsApp
            </a>
            <a class="footer-link" href="https://instagram.com/heryerde_2aa" rel="noopener" data-event="instagram">
                <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                @@heryerde_2aa
            </a>
        </div>
        <nav class="store-footer__corporate" aria-label="Kurumsal">
            <h2 class="store-footer__title">Kurumsal</h2>
            <ul class="store-footer__list store-footer__list--single">
                @foreach (var content in ContentPages.All)
                {
                    <li><a class="footer-link" href="@content.Path">@content.Title</a></li>
                }
                <li><a class="footer-link" href="/siparis-sorgula">Sipariş sorgula</a></li>
                <li><a class="footer-link" href="/ceyizlistesi/yeni">Çeyiz listesi oluştur</a></li>
                <li><a class="footer-link" href="/hesap">Hesabım</a></li>
                <li><a class="footer-link" href="/hesap/sil">Hesabımı sil</a></li>
            </ul>
        </nav>
        <nav class="store-footer__legal" aria-label="Yasal">
            <h2 class="store-footer__title">Yasal</h2>
            <ul class="store-footer__list">
                @foreach (var legal in LegalPages.All)
                {
                    <li><a class="footer-link" href="/yasal/@legal.Slug">@legal.Title</a></li>
                }
            </ul>
        </nav>
        <span>HerYerde, @DateTime.UtcNow.Year · <span class="site-footer__note">@(Iyzico.Value.IsConfigured ? "Kapıda ödeme · Havale/EFT · Kart" : "Kapıda ödeme · Havale/EFT") · Fiyatlara KDV dahildir</span></span>
        @if (Config["Legal:EtbisNo"] is { Length: > 0 } etbisNo)
        {
            <p class="store-footer__etbis">ETBİS'e kayıtlıdır · Kayıt no: <span class="store-footer__etbis-no">@etbisNo</span></p>
        }
    </footer>
    @* PWA ipucu: site.js ikinci ziyaretten itibaren açar; kapatılınca bir yıl görünmez (localStorage, çerez politikasındaki istisna). *@
    <aside class="install-hint" data-install-hint hidden aria-label="Ana ekrana ekle">
        <img class="install-hint__icon" src="/icon-192.png" alt="" width="48" height="48" loading="lazy" />
        <p class="install-hint__text">
            <strong>HerYerde'yi ana ekranınıza ekleyin.</strong>
            <span data-install-ios hidden>Safari'de Paylaş simgesine, ardından "Ana Ekrana Ekle"ye dokunun.</span>
            <span data-install-android hidden>Uygulama gibi tek dokunuşla açılır; son baktığınız sayfalar bağlantı yokken de görünür.</span>
        </p>
        <button class="btn btn--cta btn--sm install-hint__accept" type="button" data-install-accept hidden>Ekle</button>
        <button class="icon-btn install-hint__close" type="button" data-install-dismiss aria-label="İpucunu kapat">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
    </aside>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
