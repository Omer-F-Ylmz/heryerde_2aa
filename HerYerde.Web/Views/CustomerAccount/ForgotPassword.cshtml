@using HerYerde.Web.Models
@model CustomerForgotViewModel
@{
    ViewData["Title"] = "Parolamı unuttum";
    ViewData["Robots"] = "noindex, nofollow";
}

<div class="container section auth auth--single">
    <div class="auth__forms">
        <section class="form-card surface-elevated auth__card" aria-labelledby="forgot-title">
            <p class="eyebrow">Hesabım</p>
            <h1 id="forgot-title" class="display-2 h-mark">Parolamı unuttum</h1>
            @if (Model.Sent is { } sent)
            {
                <p class="form-alert form-alert--notice" role="status">@sent</p>
                <a class="btn btn--outline" href="/hesap/giris">Giriş sayfasına dön</a>
            }
            else
            {
                <p class="lead">E-postanıza 30 dakika geçerli bir parola sıfırlama bağlantısı gönderelim.</p>
                <form method="post" action="/hesap/sifremi-unuttum">
                    @Html.AntiForgeryToken()
                    <div class="field">
                        <label class="field__label" for="Email">E-posta</label>
                        <input class="field__input" id="Email" name="Email" type="email" maxlength="200" autocomplete="email" required />
                    </div>
                    <button class="btn btn--cta btn--lg" type="submit">Bağlantı gönder</button>
                </form>
            }
        </section>
    </div>
</div>
