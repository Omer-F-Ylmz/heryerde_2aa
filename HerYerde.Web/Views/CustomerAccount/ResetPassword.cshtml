@using HerYerde.Web.Models
@model CustomerResetViewModel
@{
    ViewData["Title"] = "Yeni parola";
    ViewData["Robots"] = "noindex, nofollow";
}

<div class="container section auth auth--single">
    <div class="auth__forms">
        <section class="form-card surface-elevated auth__card" aria-labelledby="reset-title">
            <p class="eyebrow">Hesabım</p>
            <h1 id="reset-title" class="display-2 h-mark">Yeni parola belirleyin</h1>
            @if (Model.ErrorMessage is { } error)
            {
                <p class="form-alert" role="alert">@error</p>
            }
            <form method="post" action="/hesap/sifre-sifirla">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Token" value="@Model.Token" />
                <div class="field">
                    <label class="field__label" for="NewPassword">Yeni parola</label>
                    <input class="field__input" id="NewPassword" name="NewPassword" type="password" minlength="10" maxlength="200" autocomplete="new-password" required aria-describedby="NewPassword-hint" />
                    <span class="field__hint" id="NewPassword-hint">En az 10 karakter. Kaydedince diğer cihazlardaki oturumlar kapanır.</span>
                </div>
                <div class="field">
                    <label class="field__label" for="ConfirmPassword">Yeni parola (tekrar)</label>
                    <input class="field__input" id="ConfirmPassword" name="ConfirmPassword" type="password" minlength="10" maxlength="200" autocomplete="new-password" required />
                </div>
                <button class="btn btn--cta btn--lg" type="submit">Parolayı kaydet</button>
            </form>
        </section>
    </div>
</div>
