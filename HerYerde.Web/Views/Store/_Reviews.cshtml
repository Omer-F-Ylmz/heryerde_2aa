@using System.Globalization
@using HerYerde.Web.Models
@model ReviewSectionVm
@{
    var turkish = CultureInfo.GetCultureInfo("tr-TR");
    var form = Model.Form;
    string? Error(string key) => ViewData.ModelState[key]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<section class="container section reviews" id="yorumlar" aria-labelledby="yorumlar-title">
    <div class="reviews__side">
        <h2 id="yorumlar-title" class="display-2 h-mark">Yorumlar</h2>
        @if (Model.Summary is { } summary)
        {
            <p class="reviews__score" data-rating-average="@summary.AverageText">
                <span class="reviews__average">@summary.AverageText</span>
                <span class="reviews__meta">
                    <partial name="Components/_Stars" model="summary.Stars" />
                    <span>5 üzerinden · @summary.Count yorum</span>
                </span>
            </p>
        }
        else
        {
            <p class="reviews__empty">Henüz yayınlanmış yorum yok. Ürünü aldıysanız ilk yorumu siz yazın.</p>
        }

        @if (Model.Notice is not null)
        {
            <p class="form-alert form-alert--notice" role="status">@Model.Notice</p>
        }

        <form class="reviews__form form-card surface-elevated" method="post" action="/urun/@Model.ProductSlug/yorum">
            @Html.AntiForgeryToken()
            <h3 class="heading-3">Yorum yazın</h3>
            <div class="chips reviews__rating" role="radiogroup" aria-labelledby="rating-legend" aria-describedby="Rating-error">
                <span class="chips__legend" id="rating-legend">Puanınız</span>
                @for (var value = 5; value >= 1; value--)
                {
                    <input class="chips__input" type="radio" id="rating-@value" name="Rating" value="@value" checked="@(form.Rating == value)" required />
                    <label class="chip" for="rating-@value">
                        <svg class="icon icon--star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                        @value
                    </label>
                }
                <span class="field__error" id="Rating-error">@Error("Rating")</span>
            </div>
            <div class="field">
                <label class="field__label" for="review-name">Adınız</label>
                <input class="field__input" id="review-name" name="Name" value="@form.Name" maxlength="60" autocomplete="given-name" required
                       aria-describedby="review-name-hint review-name-error" aria-invalid="@(Error("Name") is null ? null : "true")" />
                <span class="field__hint" id="review-name-hint">Yorumun altında bu ad görünür; "Ayşe K." gibi kısaltabilirsiniz.</span>
                <span class="field__error" id="review-name-error">@Error("Name")</span>
            </div>
            <div class="field">
                <label class="field__label" for="review-comment">Yorumunuz</label>
                <textarea class="field__input field__input--area" id="review-comment" name="Comment" rows="4" maxlength="1000" required
                          aria-describedby="review-comment-error" aria-invalid="@(Error("Comment") is null ? null : "true")">@form.Comment</textarea>
                <span class="field__error" id="review-comment-error">@Error("Comment")</span>
            </div>
            <div class="field">
                <label class="field__label" for="review-order">Sipariş numarası (isteğe bağlı)</label>
                <input class="field__input" id="review-order" name="OrderNo" value="@form.OrderNo" maxlength="20" autocomplete="off"
                       aria-describedby="review-order-hint" />
                <span class="field__hint" id="review-order-hint">Bu ürünü bizden aldıysanız yazın; siparişle eşleşirse yorumunuz alıcı rozetiyle yayınlanır.</span>
            </div>
            <p class="field__hint">Yorumlar yayından önce kontrol edilir.</p>
            <button class="btn btn--primary" type="submit">Yorumu gönder</button>
        </form>
    </div>

    @if (Model.Reviews.Count > 0)
    {
        <ol class="reviews__list">
            @foreach (var review in Model.Reviews)
            {
                <li class="review">
                    <div class="review__head">
                        <partial name="Components/_Stars" model="review.Rating" />
                        <span class="visually-hidden">5 üzerinden @review.Rating puan</span>
                        @if (review.OrderNo is not null)
                        {
                            <span class="tag tag--live">Doğrulanmış alıcı</span>
                        }
                    </div>
                    <p class="review__text">@review.Comment</p>
                    <p class="review__who">
                        <span>@review.Name</span>
                        <span aria-hidden="true">·</span>
                        <time datetime="@review.CreatedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@review.CreatedAt.ToString("d MMMM yyyy", turkish)</time>
                    </p>
                </li>
            }
        </ol>
    }
</section>
