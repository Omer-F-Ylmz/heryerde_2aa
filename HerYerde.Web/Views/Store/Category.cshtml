@using HerYerde.Web.Models
@model CategoryPageVm
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = $"{Model.Title} kategorisinde {Model.Total} ürün — kapıda ödeme, WhatsApp'tan sipariş.";
    // Süzgeç/sıralama sorgusu canonical'a girmez; 2. sayfa ve sonrası kendini gösterir.
    var path = Model.Tabs.First(t => t.Current).Url;
    ViewData["Canonical"] = Model.Pagination.Page > 1 ? $"{path}?sayfa={Model.Pagination.Page}" : path;
}

<div class="container section">
    <div class="category-band">
        <div class="category-band__copy">
            <p class="eyebrow">@Model.RootName</p>
            <h1 class="display-2 h-mark">@Model.Title</h1>
        </div>
        <div class="category-band__media@(Model.BannerImage is null && Model.LogoUrl is not null ? " category-band__media--logo" : "")">
            @if (Model.BannerImage is { } banner)
            {
                <img src="@banner" alt="" width="1200" height="675" />
            }
            else if (Model.LogoUrl is { } logo)
            {
                @* Marka sayfası: bant görseli yerine logo, düz yüzeyde ortada. *@
                <img class="category-band__logo" src="@logo" alt="" width="320" height="160" />
            }
            else
            {
                <span class="ph@(Model.BannerIcon is null ? "" : " ph--" + Model.BannerIcon)"></span>
            }
        </div>
    </div>
    <partial name="Components/_CategoryTabs" model="Model.Tabs" />
    <partial name="Components/_Listing" model="new ListingVm(Model.Sort, Model.Filter, Model.Cards, Model.Pagination, Model.EmptyLink)" />
</div>
