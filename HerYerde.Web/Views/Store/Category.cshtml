@using HerYerde.Web.Models
@model CategoryPageVm
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = $"{Model.Title} kategorisinde {Model.Total} ürün — kapıda ödeme, WhatsApp'tan sipariş.";
    // Süzgeç/sıralama sorgusu canonical'a girmez; 2. sayfa ve sonrası kendini gösterir.
    var path = Model.Tabs.First(t => t.Current).Url;
    ViewData["Canonical"] = Model.Pagination.Page > 1 ? $"{path}?sayfa={Model.Pagination.Page}" : path;
}

<div class="container section">
    <div class="category-band">
        <div class="category-band__copy">
            <p class="eyebrow">@Model.RootName</p>
            <h1 class="display-2 h-mark">@Model.Title</h1>
        </div>
        <div class="category-band__media">
            @if (Model.BannerImage is { } banner)
            {
                <img src="@banner" alt="" width="1200" height="675" />
            }
            else
            {
                <span class="ph@(Model.BannerIcon is null ? "" : " ph--" + Model.BannerIcon)"></span>
            }
        </div>
    </div>
    <partial name="Components/_CategoryTabs" model="Model.Tabs" />
    <div class="listing-bar">
        <partial name="Components/_SortTabs" model="Model.Sort" />
        <partial name="Components/_PriceFilter" model="Model.Filter" />
    </div>
    <h2 class="visually-hidden">Ürünler</h2>
    @if (Model.Cards.Count == 0)
    {
        <div class="empty surface-elevated">
            <p class="empty__title">Şu an ürün yok.</p>
            <p>Bu rafa yeni ürünler geldiğinde burada göreceksiniz.</p>
            @if (Model.EmptyLink is { } other)
            {
                <a class="btn btn--outline" href="@other.Url">@other.Name</a>
            }
        </div>
    }
    else
    {
        <div class="grid">
            @foreach (var card in Model.Cards)
            {
                <partial name="Components/_ProductCard" model="card" />
            }
        </div>
    }
    <partial name="Components/_Pagination" model="Model.Pagination" />
</div>
