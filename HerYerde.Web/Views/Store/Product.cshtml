@using HerYerde.Web.Models
@model ProductPageVm
@inject Microsoft.Extensions.Options.IOptions<HerYerde.Business.ShopSettings> Shop
@{
    var product = Model.Product;
    var price = Model.CampaignActive ? product.CampaignPrice!.Value : product.Price;
    ViewData["Title"] = product.Name;
    ViewData["Description"] = Seo.ProductDescription(product, price);
    ViewData["Canonical"] = "/urun/" + product.Slug;
    ViewData["OgType"] = "product";
    ViewData["OgImage"] = Model.Images.Count > 0 ? Model.Images[0].Url : null;
    ViewData["JsonLd"] = new[]
    {
        Seo.ProductJsonLd(Shop.Value.BaseUrl, product, price, Model.SoldOut, Model.Images.Select(i => i.Url)),
        Seo.ProductBreadcrumbJsonLd(Shop.Value.BaseUrl, Model)
    };
}

<div class="container section product-page">
    <div class="product">
        <div class="gallery">
            <figure class="gallery__main">
                @if (Model.Images.Count == 0)
                {
                    <span class="ph@(Model.PlaceholderIcon is null ? "" : " ph--" + Model.PlaceholderIcon)"></span>
                }
                else
                {
                    <img src="@Model.Images[0].Url" alt="@Model.Images[0].Alt" width="600" height="600" />
                }
            </figure>
            @if (Model.Images.Count > 1)
            {
                <ul class="gallery__thumbs">
                    @foreach (var image in Model.Images.Skip(1))
                    {
                        <li><img class="thumb" src="@image.Url" alt="@image.Alt" width="64" height="80" loading="lazy" /></li>
                    }
                </ul>
            }
        </div>
        <div class="product__info">
            <nav class="crumbs" aria-label="Konum">
                <a href="@Model.RootUrl">@Model.RootName</a>
                @if (Model.CategoryName is { } categoryName)
                {
                    <span aria-hidden="true">›</span>
                    if (Model.CategoryUrl is { } categoryUrl)
                    {
                        <a href="@categoryUrl">@categoryName</a>
                    }
                    else
                    {
                        <span>@categoryName</span>
                    }
                }
            </nav>
            <h1 class="display-2 h-mark">@product.Name</h1>
            @if (HerYerde.Web.Models.StoreCatalog.Badge(product, DateTime.UtcNow, Model.SoldOut) is { } badge)
            {
                <partial name="Components/_Badge" model="badge" />
            }
            <partial name="Components/_PriceBlock" model="new PriceBlockVm(product.Price, Model.CampaignActive ? product.CampaignPrice : null, true)" />
            @if (Model.CampaignActive && product.CampaignEndsAt is { } endsAt)
            {
                <partial name="Components/_Countdown" model="endsAt" />
            }
            @if (Model.IsClothing)
            {
                <partial name="Components/_VariantPicker" model="Model.Picker" />
                <p class="product__desc">@product.Description</p>
            }
            else
            {
                <h2 class="heading-3">Set içeriği</h2>
                <p class="product__desc">@product.Description</p>
            }
            <div class="product__cta">
                <form method="post" action="/sepet/ekle" data-add-to-cart data-variants="@Model.VariantsJson">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="variantId" value="" data-variant-id />
                    <input type="hidden" name="quantity" value="1" />
                    <input type="hidden" name="donus" value="/sepet" />
                    <button class="btn btn--cta btn--lg" type="submit" disabled="@(Model.IsClothing || Model.SoldOut)" data-add-button>
                        <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                        Sepete ekle
                    </button>
                </form>
                <a class="btn btn--outline btn--lg" href="@Model.WhatsAppUrl" rel="noopener">
                    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                    WhatsApp'tan sipariş ver
                </a>
            </div>
            @if (Model.SoldOut)
            {
                <p class="field__hint">Bu ürün şimdilik tükendi. WhatsApp'tan yazarsanız geldiğinde haber veriyoruz.</p>
            }
            else if (Model.IsClothing)
            {
                <p class="field__hint" data-add-hint>Sepete eklemek için beden ve renk seçin.</p>
            }
        </div>
    </div>
    <partial name="Components/_TrustStrip" />
</div>

@if (Model.Similar.Count > 0)
{
    <section class="container section similar" id="benzer" aria-labelledby="benzer-title">
        <h2 id="benzer-title" class="display-2 h-mark">Benzer ürünler</h2>
        <div class="grid@(Model.Similar.Count < 4 ? " grid--" + Model.Similar.Count : "")">
            @foreach (var card in Model.Similar)
            {
                <partial name="Components/_ProductCard" model="card" />
            }
        </div>
    </section>
}
