@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    ViewData["Title"] = "Bir şeyler ters gitti";
    ViewData["Robots"] = "noindex";
    ViewData["SkipCart"] = true;
}

<section class="container oops" aria-labelledby="oops-title">
    <p class="eyebrow">500</p>
    <h1 id="oops-title" class="display-1 h-mark">Bir şeyler ters gitti.</h1>
    <p class="lead">Sayfayı hazırlarken bir sorun çıktı ve kaydını aldık. Birkaç dakika sonra yeniden deneyin; beklemek istemezseniz siparişinizi WhatsApp'tan yazın.</p>
    <div class="sg-row">
        <a class="btn btn--cta" href="@Config["Shop:WhatsApp"]" rel="noopener">
            <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            WhatsApp'tan yazın
        </a>
        <a class="btn btn--outline" href="/">Ana sayfaya dön</a>
    </div>
</section>
