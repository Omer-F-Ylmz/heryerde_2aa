@{
    ViewData["Title"] = "Yakında";
}

<section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
        <p class="eyebrow">Yakında açılıyor</p>
        <h1 id="hero-title" class="display-1">Şalvardan sofraya, evin her yeri.</h1>
        <p class="lead">Rahat şalvarlar ve mutfaktan dekora ev parçaları tek yerde. Beğendiğinizi kapıda ödemeyle alın, kargoyu bekleyin.</p>
    </div>
    <aside class="hero__panel surface-elevated" aria-label="İki alan">
        <p class="panel__label">İki alan</p>
        <ol class="panel__list">
            <li>
                <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                <span class="panel__area">Giyim</span>
                <span class="panel__hint">Beden ve renk seçimiyle</span>
            </li>
            <li>
                <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11h18"/><path d="M12 11V3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M6 21h12"/><path d="M12 18v3"/></svg>
                <span class="panel__area">Ev</span>
                <span class="panel__hint">Mutfak, saklama, dekor</span>
            </li>
        </ol>
    </aside>
</section>
