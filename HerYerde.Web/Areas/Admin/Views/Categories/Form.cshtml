@model CategoryFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? $"{Model.Name} düzenle" : "Yeni kategori";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Kategori</p>
        <h1 class="display-2">@(isEdit ? Model.Name : "Yeni kategori")</h1>
        @if (Model.IsRoot)
        {
            <p class="page-head__note">Bu bir kök alan: adresi (@Model.Slug) ve ağaçtaki yeri sabit kalır.</p>
        }
        else
        {
            <p class="page-head__note">Adres addan üretilir; aynı adres varsa sonuna -2 eklenir.</p>
        }
    </div>
    <a class="btn btn--ghost" asp-area="Admin" asp-controller="Categories" asp-action="Index">Listeye dön</a>
</div>

@if (Model.ErrorMessage is not null)
{
    <p class="form-alert" role="alert">@Model.ErrorMessage</p>
}

<form class="form-card surface-elevated" method="post" asp-area="Admin" asp-controller="Categories" asp-action="@(isEdit ? "Edit" : "Create")">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsRoot" />

    <div class="field">
        <label class="field__label" asp-for="Name"></label>
        <input class="field__input" asp-for="Name" autocomplete="off" />
        <span class="field__error" asp-validation-for="Name"></span>
    </div>

    <div class="field-row">
        <div class="field">
            <label class="field__label" asp-for="ParentId"></label>
            @if (Model.IsRoot)
            {
                <p class="field__static">Kök alan — üst kategorisi yok.</p>
            }
            else
            {
                <select class="field__input" asp-for="ParentId">
                    <option value="">Kök alan olarak aç</option>
                    @foreach (var parent in Model.Parents)
                    {
                        <option value="@parent.Id" selected="@(Model.ParentId == parent.Id)">@parent.Name</option>
                    }
                </select>
            }
        </div>

        <div class="field">
            <label class="field__label" asp-for="SortOrder"></label>
            <input class="field__input" asp-for="SortOrder" type="number" min="0" max="999" />
            <span class="field__error" asp-validation-for="SortOrder"></span>
        </div>
    </div>

    <label class="switch">
        <input asp-for="IsActive" type="checkbox" />
        <span>Yayında</span>
    </label>

    <div class="form-card__foot">
        <button class="btn btn--primary" type="submit">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"/><path d="M7 3v4a1 1 0 0 0 1 1h7"/></svg>
            <span>Kaydet</span>
        </button>
    </div>
</form>
