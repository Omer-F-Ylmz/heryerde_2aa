@model List<HerYerde.Entities.Concrete.Brand>
@{
    ViewData["Title"] = "Markalar";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Katalog</p>
        <h1 class="display-2">Markalar</h1>
        <p class="page-head__note">Marka ürün formundan seçilir; vitrinde /marka/… sayfası ve ürün akışlarında görünür. Adın yazımı ürün adı önerisinde korunur.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--primary" href="/admin/markalar/yeni">Marka ekle</a>
    </div>
</div>

@if (TempData["MarkaHata"] is string error)
{
    <p class="form-alert" role="alert">@error</p>
}

@if (Model.Count == 0)
{
    <p class="empty surface-elevated">Henüz marka yok.</p>
}
else
{
    <div class="table-wrap surface-elevated">
        <table class="table">
            <caption class="visually-hidden">Markalar ve vitrin adresleri</caption>
            <thead>
                <tr>
                    <th scope="col">Marka</th>
                    <th scope="col">Adres</th>
                    <th scope="col"><span class="visually-hidden">İşlem</span></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var brand in Model)
            {
                <tr>
                    <th scope="row">
                        <div class="cell-product">
                            @if (brand.LogoUrl is { } logo)
                            {
                                <img class="thumb" src="@logo" alt="" width="56" height="28" loading="lazy" />
                            }
                            <span>@brand.Name</span>
                        </div>
                    </th>
                    <td><a class="cell-mono" href="/marka/@brand.Slug">/marka/@brand.Slug</a></td>
                    <td>
                        <div class="table__actions">
                            <a class="btn btn--ghost btn--sm" href="/admin/markalar/@brand.Id">Düzenle</a>
                            <form method="post" action="/admin/markalar/@brand.Id/sil">
                                @Html.AntiForgeryToken()
                                <button class="btn btn--danger btn--sm" type="submit">Sil</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
