@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Parola değiştir";
}

<div class="page-head">
    <h1 class="display-2">Parola değiştir</h1>
    <p class="page-head__note">Parola değişince bu tarayıcı açık kalır, diğer oturumların hepsi düşer.</p>
</div>

<div class="form-card form-card--narrow surface-elevated">
    @if (Model.Changed)
    {
        <p class="form-alert form-alert--notice" role="status">Parola değiştirildi. Diğer cihazlardaki oturumlar kapandı.</p>
        <div class="form-card__foot">
            <a class="btn btn--primary" asp-area="Admin" asp-controller="Products" asp-action="Index">Ürünlere dön</a>
        </div>
    }
    else
    {
        <form method="post" asp-area="Admin" asp-controller="Auth" asp-action="ChangePassword">
            @if (Model.ErrorMessage is not null)
            {
                <p class="form-alert" role="alert">@Model.ErrorMessage</p>
            }

            <div class="field">
                <label class="field__label" asp-for="CurrentPassword"></label>
                <input class="field__input" asp-for="CurrentPassword" type="password" autocomplete="current-password" />
                <span class="field__error" asp-validation-for="CurrentPassword"></span>
            </div>

            <div class="field">
                <label class="field__label" asp-for="NewPassword"></label>
                <input class="field__input" asp-for="NewPassword" type="password" autocomplete="new-password" />
                <span class="field__hint">En az 10 karakter ve en az bir rakam.</span>
                <span class="field__error" asp-validation-for="NewPassword"></span>
            </div>

            <div class="field">
                <label class="field__label" asp-for="ConfirmPassword"></label>
                <input class="field__input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span class="field__error" asp-validation-for="ConfirmPassword"></span>
            </div>

            <div class="form-card__foot">
                <a class="btn btn--ghost" asp-area="Admin" asp-controller="Products" asp-action="Index">Vazgeç</a>
                <button class="btn btn--primary" type="submit">Parolayı değiştir</button>
            </div>
        </form>
    }
</div>
