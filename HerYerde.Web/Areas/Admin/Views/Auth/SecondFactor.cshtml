@model SecondFactorViewModel
@{
    ViewData["Title"] = "İki adımlı doğrulama";
}

<section class="gate gate--single">
    <div class="gate__card surface-elevated">
        <div class="gate__card-head">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            <h1 class="heading-3">Doğrulama kodu</h1>
        </div>

        <form method="post" action="/admin/auth/iki-adim">
            @Html.AntiForgeryToken()
            @if (Model.ErrorMessage is not null)
            {
                <p class="form-alert" role="alert">@Model.ErrorMessage</p>
            }
            <div class="field">
                <label class="field__label" asp-for="Code"></label>
                <input class="field__input field__input--code" asp-for="Code" autocomplete="one-time-code" inputmode="text" maxlength="11" autofocus />
                <span class="field__hint">Uygulamadaki 6 haneli kod ya da yedek kodlarınızdan biri.</span>
            </div>
            <button class="btn btn--primary btn--block" type="submit">Doğrula</button>
        </form>
        <p class="gate__note">Beş hatalı koddan sonra hesap 15 dakika kilitlenir. <a href="/admin/auth/login">Girişe dön</a></p>
    </div>
</section>
