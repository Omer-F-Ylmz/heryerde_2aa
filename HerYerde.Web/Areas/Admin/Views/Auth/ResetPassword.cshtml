@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni parola";
}

<section class="gate gate--single">
    <div class="gate__card surface-elevated">
        <div class="gate__card-head">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/></svg>
            <h1 class="heading-3">Yeni parola</h1>
        </div>

        <form method="post" action="/admin/auth/sifre-sifirla">
            @Html.AntiForgeryToken()
            @if (Model.ErrorMessage is not null)
            {
                <p class="form-alert" role="alert">@Model.ErrorMessage</p>
            }
            <input type="hidden" asp-for="Token" />

            <div class="field">
                <label class="field__label" asp-for="NewPassword"></label>
                <input class="field__input" asp-for="NewPassword" type="password" autocomplete="new-password" />
                <span class="field__hint">En az 10 karakter ve en az bir rakam.</span>
                <span class="field__error" asp-validation-for="NewPassword"></span>
            </div>

            <div class="field">
                <label class="field__label" asp-for="ConfirmPassword"></label>
                <input class="field__input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span class="field__error" asp-validation-for="ConfirmPassword"></span>
            </div>

            <button class="btn btn--primary btn--block" type="submit">Parolayı kaydet</button>
        </form>
        <p class="gate__note">Parola değişince açık oturumların hepsi kapanır. <a href="/admin/auth/sifremi-unuttum">Yeni bağlantı iste</a></p>
    </div>
</section>
