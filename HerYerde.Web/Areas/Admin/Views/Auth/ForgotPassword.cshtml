@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Parolamı unuttum";
}

<section class="gate gate--single">
    <div class="gate__card surface-elevated">
        <div class="gate__card-head">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <h1 class="heading-3">Parolamı unuttum</h1>
        </div>

        @if (Model.Sent is not null)
        {
            <p class="form-alert form-alert--notice" role="status">@Model.Sent Bağlantı 30 dakika geçerli.</p>
            <a class="btn btn--ghost btn--block" href="/admin/auth/login">Girişe dön</a>
        }
        else
        {
            <form method="post" action="/admin/auth/sifremi-unuttum">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label class="field__label" asp-for="Email"></label>
                    <input class="field__input" asp-for="Email" autocomplete="username" inputmode="email" />
                    <span class="field__hint">Yönetici e-postasına tek kullanımlık bir bağlantı gider.</span>
                    <span class="field__error" asp-validation-for="Email"></span>
                </div>
                <button class="btn btn--primary btn--block" type="submit">Bağlantı gönder</button>
            </form>
            <p class="gate__note"><a href="/admin/auth/login">Girişe dön</a></p>
        }
    </div>
</section>
