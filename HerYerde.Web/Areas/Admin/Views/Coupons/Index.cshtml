@using System.Globalization
@using HerYerde.DataAccess.Abstract
@using HerYerde.Entities.Enums
@using HerYerde.Web.Models
@model List<CouponRow>
@{
    ViewData["Title"] = "Kuponlar";
    var turkish = CultureInfo.GetCultureInfo("tr-TR");
    var now = DateTime.UtcNow;

    string Benefit(HerYerde.Entities.Concrete.Coupon coupon) => coupon.Kind switch
    {
        CouponKind.Yuzde => "%" + coupon.Value.ToString("0.##", turkish),
        CouponKind.Tutar => Money.Tl(coupon.Value),
        _ => "Kargo bedava"
    };
}

<div class="page-head">
    <div>
        <p class="eyebrow">Vitrin</p>
        <h1 class="display-2">Kuponlar</h1>
        <p class="page-head__note">Kod sepette ve ödeme adımında girilir. Kullanım sayısı iptal edilmemiş siparişlerden gelir; kupon silinse de geçmiş siparişlerdeki kod kaydı durur.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--primary" href="/admin/kuponlar/yeni">Yeni kupon</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <p class="empty surface-elevated">Henüz kupon yok.</p>
}
else
{
    <div class="table-wrap surface-elevated">
    <table class="table">
        <caption class="visually-hidden">Tanımlı kuponlar ve kullanım sayıları</caption>
        <thead>
            <tr>
                <th scope="col">Kod</th>
                <th scope="col">İndirim</th>
                <th scope="col">Alt sınır</th>
                <th scope="col">Tarih</th>
                <th scope="col">Kullanım</th>
                <th scope="col">Durum</th>
                <th scope="col"><span class="visually-hidden">İşlem</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (coupon, used) in Model)
            {
                var live = coupon.IsActive && coupon.StartsAt <= now && coupon.EndsAt > now;
                <tr>
                    <th scope="row"><a class="cell-mono" href="/admin/kuponlar/@coupon.Id">@coupon.Code</a></th>
                    <td>@Benefit(coupon)</td>
                    <td class="table__num">@(coupon.MinSubtotal > 0m ? Money.Tl(coupon.MinSubtotal) : "—")</td>
                    <td class="table__date">@coupon.StartsAt.ToString("d MMM yyyy", turkish) – @coupon.EndsAt.AddDays(-1).ToString("d MMM yyyy", turkish)</td>
                    <td>
                        <div class="cell-product">
                            <span>@used@(coupon.TotalLimit is { } limit ? " / " + limit : "")</span>
                            @if (coupon.PerPersonLimit is { } perPerson)
                            {
                                <span class="cell-mono">kişi başı @perPerson</span>
                            }
                        </div>
                    </td>
                    <td>
                        @if (live)
                        {
                            <span class="tag tag--live">Geçerli</span>
                        }
                        else if (coupon.IsActive)
                        {
                            <span class="tag">Tarih dışı</span>
                        }
                        else
                        {
                            <span class="tag">Kapalı</span>
                        }
                    </td>
                    <td>
                        <div class="table__actions">
                            <a class="btn btn--ghost btn--sm" href="/admin/kuponlar/@coupon.Id">Düzenle</a>
                            <form method="post" action="/admin/kuponlar/@coupon.Id/sil">
                                @Html.AntiForgeryToken()
                                <button class="btn btn--danger btn--sm" type="submit">Sil</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
