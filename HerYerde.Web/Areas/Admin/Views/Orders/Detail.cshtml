@using HerYerde.Entities.Enums
@using HerYerde.Web.Models
@model OrderDetailViewModel
@{
    var order = Model.Detail.Order;
    ViewData["Title"] = order.OrderNo;
}

<div class="page-head">
    <div>
        <p class="eyebrow">Sipariş</p>
        <h1 class="display-2">@order.OrderNo</h1>
        <p class="page-head__note">@IstanbulTime.Format(order.CreatedAt) · <partial name="Components/_StatusPill" model="order.Status" /></p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--cta" href="@Model.WhatsAppUrl" rel="noopener" target="_blank">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            <span>WhatsApp'tan yaz</span>
        </a>
        <a class="btn btn--ghost" asp-area="Admin" asp-controller="Orders" asp-action="Index">Listeye dön</a>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <p class="form-alert" role="alert">@Model.ErrorMessage</p>
}

<div class="surface-elevated form-card">
    <dl class="order-facts">
        <div>
            <dt>Müşteri</dt>
            <dd>@order.FullName<br />@order.Phone@(order.Email is null ? "" : " · " + order.Email)</dd>
        </div>
        <div>
            <dt>Adres</dt>
            <dd>@order.Address<br />@order.District / @order.City</dd>
        </div>
        <div>
            <dt>Ödeme</dt>
            <dd>
                @PaymentLabels.Method(order.PaymentMethod)
                @if (Model.Detail.Payment is { } payment)
                {
                    <br />
                    <span>@PaymentLabels.Status(payment.Status) · @payment.Provider</span><br />
                    <span class="cell-mono">@(payment.PaymentId ?? "—")</span>
                }
            </dd>
        </div>
        <div>
            <dt>Not</dt>
            <dd>@(order.Note ?? "—")</dd>
        </div>
        @if (order.Carrier is { } carrier)
        {
            <div>
                <dt>Kargo</dt>
                <dd>
                    @carrier<br />
                    @if (Model.TrackingUrl is { } tracking)
                    {
                        <a href="@tracking" rel="noopener" target="_blank">@order.TrackingNo</a>
                    }
                    else
                    {
                        <span class="cell-mono">@order.TrackingNo</span>
                    }
                </dd>
            </div>
        }
        <div>
            <dt>Sözleşme</dt>
            <dd>
                @if (order.LegalVersion is { } version)
                {
                    <a href="/yasal/mesafeli-satis-sozlesmesi">Mesafeli satış sözleşmesi</a><br />
                    <span>Sürüm @version · onay @IstanbulTime.Format(order.ConsentAt ?? order.CreatedAt)</span>
                }
                else
                {
                    <span>—</span>
                }
            </dd>
        </div>
    </dl>

    <div class="table-wrap">
        <table class="table">
            <caption class="visually-hidden">Sipariş satırları</caption>
            <thead>
                <tr>
                    <th scope="col">Ürün</th>
                    <th scope="col">Stok kodu</th>
                    <th scope="col" class="table__num">Adet</th>
                    <th scope="col" class="table__num">Birim</th>
                    <th scope="col" class="table__num">Tutar</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Detail.Items)
            {
                <tr>
                    <th scope="row">@item.ProductName</th>
                    <td><span class="cell-mono">@item.Sku</span></td>
                    <td class="table__num">@item.Quantity</td>
                    <td class="table__num">@Money.Tl(item.UnitPrice)</td>
                    <td class="table__num">@Money.Tl(item.UnitPrice * item.Quantity)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <p class="summary__row">
        <span>Ara toplam</span>
        <span class="summary__value">@Money.Tl(order.Subtotal)</span>
    </p>
    <p class="summary__row">
        <span>Kargo</span>
        <span class="summary__value">@(order.ShippingFee == 0m ? "Kargo bedava" : Money.Tl(order.ShippingFee))</span>
    </p>
    <p class="summary__row summary__row--total">
        <span>Toplam</span>
        <span class="summary__value">@Money.Tl(order.Total)</span>
    </p>

    <div class="order-actions">
        @if (Model.NextStatus is { } next)
        {
            <form class="@(Model.NeedsShipment ? "shipment" : null)"
                  asp-area="Admin" asp-controller="Orders" asp-action="ChangeStatus" asp-route-id="@order.Id" method="post">
                <input type="hidden" name="next" value="@((int)next)" />
                @if (Model.NeedsShipment)
                {
                    <div class="field">
                        <label class="field__label" for="carrier">Kargo firması</label>
                        <select class="field__input" id="carrier" name="carrier" required>
                            <option value="">Seçin</option>
                            @foreach (var firm in Model.Carriers)
                            {
                                <option value="@firm">@firm</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label class="field__label" for="trackingNo">Takip numarası</label>
                        <input class="field__input" id="trackingNo" name="trackingNo" autocomplete="off" required />
                    </div>
                }
                <button class="btn btn--primary" type="submit">@NextLabel(next)</button>
            </form>
        }
        @if (Model.CanCancel)
        {
            <form asp-area="Admin" asp-controller="Orders" asp-action="ChangeStatus" asp-route-id="@order.Id" method="post">
                <input type="hidden" name="next" value="@((int)OrderStatus.IptalEdildi)" />
                <button class="btn btn--danger" type="submit">Siparişi iptal et</button>
            </form>
        }
        @if (Model.NextStatus is null && !Model.CanCancel)
        {
            <p class="side-card__note">Bu sipariş kapandı; durumu değişmez.</p>
        }
        @if (Model.CanAnonymize)
        {
            <form asp-area="Admin" asp-controller="Orders" asp-action="Anonymize" asp-route-id="@order.Id" method="post">
                <button class="btn btn--danger" type="submit">Kişisel veriyi anonimleştir</button>
            </form>
        }
    </div>
</div>

@functions {
    private static string NextLabel(OrderStatus next) => next switch
    {
        OrderStatus.Onaylandi => "Siparişi onayla",
        OrderStatus.Kargoda => "Kargoya verdim",
        _ => "Teslim edildi olarak işaretle"
    };
}
