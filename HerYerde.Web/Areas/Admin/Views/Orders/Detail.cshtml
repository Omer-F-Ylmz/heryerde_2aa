@using HerYerde.Entities.Enums
@using HerYerde.Web.Models
@model OrderDetailViewModel
@{
    var order = Model.Detail.Order;
    ViewData["Title"] = order.OrderNo;
}

<div class="page-head">
    <div>
        <p class="eyebrow">Sipariş</p>
        <h1 class="display-2">@order.OrderNo</h1>
        <p class="page-head__note">@IstanbulTime.Format(order.CreatedAt) · <partial name="Components/_StatusPill" model="order.Status" />@(order.Source == OrderSource.Site ? "" : " · " + PaymentLabels.Source(order.Source))</p>
    </div>
    <div class="page-head__actions">
        @if (Model.CanEdit)
        {
            <a class="btn btn--ghost" href="/admin/orders/@order.Id/duzenle">Düzenle</a>
        }
        <a class="btn btn--cta" href="@Model.WhatsAppUrl" rel="noopener" target="_blank">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            <span>WhatsApp'tan yaz</span>
        </a>
        <a class="btn btn--ghost" href="/admin/orders/@order.Id/fis" target="_blank" rel="noopener">Fiş yazdır</a>
        <a class="btn btn--ghost" href="/admin/orders/@order.Id/etiket" target="_blank" rel="noopener">Etiket yazdır</a>
        <a class="btn btn--ghost" asp-area="Admin" asp-controller="Orders" asp-action="Index">Listeye dön</a>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <p class="form-alert" role="alert">@Model.ErrorMessage</p>
}

<div class="surface-elevated form-card">
    <dl class="order-facts">
        <div>
            <dt>Müşteri</dt>
            <dd>@order.FullName<br />@order.Phone@(order.Email is null ? "" : " · " + order.Email)</dd>
        </div>
        @if (Model.Member is { } member)
        {
            @* KVKK aracı kişiyi POST ile arar: e-posta adres satırına ve tarayıcı geçmişine girmez. *@
            <div>
                <dt>Üye hesabı</dt>
                <dd>
                    @member.Email · üyelik @member.CreatedAt.ToString("d MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))
                    <form method="post" action="/admin/kvkk" class="order-facts__form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ara" value="@member.Email" />
                        <button class="btn btn--ghost btn--sm" type="submit">Üyenin kayıtları</button>
                    </form>
                </dd>
            </div>
        }
        <div>
            <dt>Adres</dt>
            <dd>@order.Address<br />@order.District / @order.City</dd>
        </div>
        <div>
            <dt>Ödeme</dt>
            <dd>
                @PaymentLabels.Method(order.PaymentMethod)
                @if (Model.Detail.Payment is { } payment)
                {
                    <br />
                    <span>@PaymentLabels.Status(payment.Status) · @payment.Provider</span><br />
                    <span class="cell-mono">@(payment.PaymentId ?? "—")</span>
                }
                @foreach (var notice in Model.Detail.Notices ?? [])
                {
                    <br />
                    <span class="notice-line">
                        Bildirim: @notice.SenderName · @Money.Tl(notice.Amount) · @notice.PaidOn.ToString("dd.MM.yyyy")
                        @if (notice.ReceiptFile is not null)
                        {
                            <a href="/admin/orders/@order.Id/dekont/@notice.Id">dekont</a>
                        }
                        @(notice.ApprovedAt is null ? " · bekliyor" : " · onaylandı")
                    </span>
                }
            </dd>
        </div>
        <div>
            <dt>Fatura</dt>
            <dd>
                @if (order.InvoiceNo is { } invoiceNo)
                {
                    <span class="cell-mono">@invoiceNo</span>
                    <span> · @(order.InvoiceDate?.ToString("dd.MM.yyyy"))</span>
                    @if (order.InvoiceFile is not null)
                    {
                        <br /><a href="/admin/orders/@order.Id/fatura">PDF'i aç</a>
                    }
                }
                else
                {
                    <span>—</span>
                }
            </dd>
        </div>
        <div>
            <dt>Not</dt>
            <dd>@(order.Note ?? "—")</dd>
        </div>
        @if (order.RefundDue is { } refundDue)
        {
            <div>
                <dt>Geri ödeme</dt>
                <dd>
                    Müşteri iptali · @Money.Tl(refundDue)<br />
                    <span class="cell-mono">@order.RefundIban</span><br />
                    <span>@(order.RefundedAt is { } refundedAt ? "ödendi " + IstanbulTime.Format(refundedAt) : "bekliyor")</span>
                </dd>
            </div>
        }
        @if (order.Carrier is { } carrier)
        {
            <div>
                <dt>Kargo</dt>
                <dd>
                    @carrier<br />
                    @if (Model.TrackingUrl is { } tracking)
                    {
                        <a href="@tracking" rel="noopener" target="_blank">@order.TrackingNo</a>
                    }
                    else
                    {
                        <span class="cell-mono">@order.TrackingNo</span>
                    }
                </dd>
            </div>
        }
        <div>
            <dt>Sözleşme</dt>
            <dd>
                @if (order.LegalVersion is { } version)
                {
                    <a href="/yasal/mesafeli-satis-sozlesmesi">Mesafeli satış sözleşmesi</a><br />
                    <span>Sürüm @version · onay @IstanbulTime.Format(order.ConsentAt ?? order.CreatedAt)</span>
                }
                else
                {
                    <span>—</span>
                }
            </dd>
        </div>
    </dl>

    <div class="table-wrap">
        <table class="table">
            <caption class="visually-hidden">Sipariş satırları</caption>
            <thead>
                <tr>
                    <th scope="col">Ürün</th>
                    <th scope="col">Stok kodu</th>
                    <th scope="col" class="table__num">Adet</th>
                    <th scope="col" class="table__num">Birim</th>
                    <th scope="col" class="table__num">Tutar</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Detail.Items)
            {
                <tr>
                    <th scope="row">@item.ProductName</th>
                    <td><span class="cell-mono">@item.Sku</span></td>
                    <td class="table__num">@item.Quantity</td>
                    <td class="table__num">@Money.Tl(item.UnitPrice)</td>
                    <td class="table__num">@Money.Tl(item.UnitPrice * item.Quantity)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <p class="summary__row">
        <span>Ara toplam</span>
        <span class="summary__value">@Money.Tl(order.Subtotal)</span>
    </p>
    <p class="summary__row">
        <span>Kargo</span>
        <span class="summary__value">@(order.ShippingFee == 0m ? "Kargo bedava" : Money.Tl(order.ShippingFee))</span>
    </p>
    <p class="summary__row summary__row--total">
        <span>Toplam</span>
        <span class="summary__value">@Money.Tl(order.Total)</span>
    </p>

    <div class="order-actions">
        @if (Model.CanApproveTransfer)
        {
            <form method="post" action="/admin/orders/@order.Id/havale-onayla">
                @Html.AntiForgeryToken()
                <button class="btn btn--primary" type="submit">Havale geldi, onayla</button>
            </form>
        }
        else if (Model.NextStatus is { } next)
        {
            <form class="@(Model.NeedsShipment ? "shipment" : null)"
                  asp-area="Admin" asp-controller="Orders" asp-action="ChangeStatus" asp-route-id="@order.Id" method="post">
                <input type="hidden" name="next" value="@((int)next)" />
                @if (Model.NeedsShipment)
                {
                    <div class="field">
                        <label class="field__label" for="carrier">Kargo firması</label>
                        <select class="field__input" id="carrier" name="carrier" required>
                            <option value="">Seçin</option>
                            @foreach (var firm in Model.Carriers)
                            {
                                <option value="@firm">@firm</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label class="field__label" for="trackingNo">Takip numarası</label>
                        <input class="field__input" id="trackingNo" name="trackingNo" autocomplete="off" required />
                    </div>
                }
                <button class="btn btn--primary" type="submit">@NextLabel(next)</button>
            </form>
        }
        @if (Model.CanCancel)
        {
            <form asp-area="Admin" asp-controller="Orders" asp-action="ChangeStatus" asp-route-id="@order.Id" method="post">
                <input type="hidden" name="next" value="@((int)OrderStatus.IptalEdildi)" />
                <button class="btn btn--danger" type="submit">Siparişi iptal et</button>
            </form>
        }
        @if (Model.CanRefund)
        {
            <form method="post" action="/admin/orders/@order.Id/iade">
                @Html.AntiForgeryToken()
                <button class="btn btn--danger" type="submit">İade et (@Money.Tl(Model.Detail.Payment!.Amount))</button>
            </form>
        }
        @if (Model.NextStatus is null && !Model.CanCancel)
        {
            <p class="side-card__note">Bu sipariş kapandı; durumu değişmez.</p>
        }
        @if (order is { RefundDue: not null, RefundedAt: null })
        {
            <form method="post" action="/admin/orders/@order.Id/geri-odendi">
                @Html.AntiForgeryToken()
                <button class="btn btn--primary" type="submit">@Money.Tl(order.RefundDue.Value) IBAN'a ödendi</button>
            </form>
        }
        @if (Model.CanAnonymize)
        {
            <form asp-area="Admin" asp-controller="Orders" asp-action="Anonymize" asp-route-id="@order.Id" method="post">
                <button class="btn btn--danger" type="submit">Kişisel veriyi anonimleştir</button>
            </form>
        }
    </div>
</div>

<section class="form-card surface-elevated timeline" aria-labelledby="timeline-title">
    <h2 class="heading-3" id="timeline-title">Zaman çizelgesi</h2>
    <ol class="timeline__list">
        @foreach (var entry in Model.Timeline)
        {
            <li class="timeline__item timeline__item--@entry.Kind" data-timeline-at="@entry.At.ToString("o")" data-timeline-kind="@entry.Kind">
                <span class="timeline__at cell-mono">@IstanbulTime.Format(entry.At)</span>
                <span class="timeline__title">@entry.Title</span>
                @if (entry.Detail is { Length: > 0 } detail)
                {
                    <span class="timeline__detail">@detail</span>
                }
                @if (entry.Actor is { } actor)
                {
                    <span class="timeline__actor">@actor</span>
                }
            </li>
        }
    </ol>
    <form class="timeline__note" method="post" action="/admin/orders/@order.Id/not">
        @Html.AntiForgeryToken()
        <div class="field">
            <label class="field__label" for="note-text">İç not (müşteri görmez)</label>
            <textarea class="field__input" id="note-text" name="text" rows="2" maxlength="1000" required></textarea>
        </div>
        <button class="btn btn--secondary" type="submit">Not ekle</button>
    </form>
</section>

<form class="form-card surface-elevated invoice-form" method="post" action="/admin/orders/@order.Id/fatura" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <h2 class="heading-3">@(order.InvoiceNo is null ? "Fatura ekle" : "Faturayı değiştir")</h2>
    <p class="fieldset__note">Muhasebe programında kesilen faturanın PDF'i. Müşteri sipariş sayfasından indirir.</p>
    <div class="field-row field-row--three">
        <div class="field">
            <label class="field__label" for="invoiceNo">Fatura no</label>
            <input class="field__input field__input--mono" id="invoiceNo" name="invoiceNo" value="@order.InvoiceNo" maxlength="40" autocomplete="off" required />
        </div>
        <div class="field">
            <label class="field__label" for="invoiceDate">Fatura tarihi</label>
            <input class="field__input" id="invoiceDate" name="invoiceDate" type="date" value="@(order.InvoiceDate?.ToString("yyyy-MM-dd"))" required />
        </div>
        <div class="field">
            <label class="field__label" for="invoiceFile">PDF (en çok 5 MB)</label>
            <input class="field__input field__input--file" id="invoiceFile" name="file" type="file" accept="application/pdf" required />
        </div>
    </div>
    <div class="form-card__foot">
        <button class="btn btn--secondary" type="submit">Faturayı kaydet</button>
    </div>
</form>

@functions {
    private static string NextLabel(OrderStatus next) => next switch
    {
        OrderStatus.Onaylandi => "Siparişi onayla",
        OrderStatus.Hazirlaniyor => "Hazırlamaya başladım",
        OrderStatus.Kargoda => "Kargoya verdim",
        _ => "Teslim edildi olarak işaretle"
    };
}
