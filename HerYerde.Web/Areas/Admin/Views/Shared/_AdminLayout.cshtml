@using HerYerde.Business.Abstract
@inject IOrderService OrderService
@inject IProductService ProductService
@inject Microsoft.Extensions.Options.IOptions<HerYerde.Business.ShopSettings> Shop
@{
    // İki adımlı kod bekleyen çerez de kimlik taşır ama panel yetkisi yoktur: çerçeve yalnız tam girişte.
    var signedIn = User.HasClaim(AdminPolicy.ClaimType, AdminPolicy.ClaimValue);
    var section = ViewContext.RouteData.Values["controller"] as string;
    // Rozetler yalnız girişten sonra sorulur; çıkış ekranında veritabanına gidilmez.
    var unseen = signedIn ? (await OrderService.UnseenCountAsync()).Item2.Data : 0;
    var lowStock = signedIn ? (await ProductService.CountLowStockAsync(Shop.Value.LowStockAlertAt)).Item2.Data : 0;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? $"{t} · HerYerde yönetim" : "HerYerde yönetim")</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#A8442A" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body surface-base">
    @if (signedIn)
    {
        <div class="admin-shell">
            <header class="admin-rail">
                <a class="admin-rail__brand" href="/" aria-label="HerYerde vitrinine dön">
                    <span class="wordmark wordmark--rail">HerYerde</span>
                    <span class="admin-rail__tag">Yönetim</span>
                </a>
                <nav class="admin-nav" aria-label="Yönetim bölümleri">
                    <a class="admin-nav__link @(section == "Dashboard" ? "is-current" : null)"
                       href="/admin"
                       aria-current="@(section == "Dashboard" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                        <span>Pano</span>
                    </a>
                    <a class="admin-nav__link @(section == "Products" ? "is-current" : null)"
                       asp-area="Admin" asp-controller="Products" asp-action="Index"
                       aria-current="@(section == "Products" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                        <span>Ürünler</span>
                    </a>
                    <a class="admin-nav__link @(section == "Orders" ? "is-current" : null)"
                       asp-area="Admin" asp-controller="Orders" asp-action="Index"
                       aria-current="@(section == "Orders" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                        <span>Siparişler</span>
                        @if (unseen > 0)
                        {
                            <span class="admin-nav__count" data-unseen-count="@unseen">
                                @unseen
                                <span class="visually-hidden">okunmamış sipariş</span>
                            </span>
                        }
                    </a>
                    <a class="admin-nav__link @(section == "Returns" ? "is-current" : null)"
                       href="/admin/iadeler"
                       aria-current="@(section == "Returns" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>
                        <span>İadeler</span>
                    </a>
                    <a class="admin-nav__link @(section == "Report" ? "is-current" : null)"
                       href="/admin/rapor"
                       aria-current="@(section == "Report" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
                        <span>Rapor</span>
                    </a>
                    <a class="admin-nav__link @(section == "Stock" ? "is-current" : null)"
                       href="/admin/stok"
                       aria-current="@(section == "Stock" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                        <span>Stok</span>
                        @if (lowStock > 0)
                        {
                            <span class="admin-nav__count" data-low-stock-count>@lowStock<span class="visually-hidden"> düşük stok</span></span>
                        }
                    </a>
                    <a class="admin-nav__link @(section == "Categories" ? "is-current" : null)"
                       asp-area="Admin" asp-controller="Categories" asp-action="Index"
                       aria-current="@(section == "Categories" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
                        <span>Kategoriler</span>
                    </a>
                    <a class="admin-nav__link @(section == "Brands" ? "is-current" : null)"
                       href="/admin/markalar"
                       aria-current="@(section == "Brands" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4Z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>
                        <span>Markalar</span>
                    </a>
                    <a class="admin-nav__link @(section == "Coupons" ? "is-current" : null)"
                       href="/admin/kuponlar"
                       aria-current="@(section == "Coupons" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M9 9v6"/></svg>
                        <span>Kuponlar</span>
                    </a>
                    <a class="admin-nav__link @(section == "GiftRegistries" ? "is-current" : null)"
                       href="/admin/ceyizlistesi"
                       aria-current="@(section == "GiftRegistries" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg>
                        <span>Çeyiz listeleri</span>
                    </a>
                    <a class="admin-nav__link @(section == "SearchReport" ? "is-current" : null)"
                       href="/admin/arama"
                       aria-current="@(section == "SearchReport" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        <span>Arama raporu</span>
                    </a>
                    <a class="admin-nav__link @(section == "Announcements" ? "is-current" : null)"
                       href="/admin/duyurular"
                       aria-current="@(section == "Announcements" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 18-5v12L3 14v-3Z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
                        <span>Duyurular</span>
                    </a>
                    <a class="admin-nav__link @(section == "Messages" ? "is-current" : null)"
                       href="/admin/mesajlar"
                       aria-current="@(section == "Messages" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        <span>Mesajlar</span>
                    </a>
                    <a class="admin-nav__link @(section == "Reviews" ? "is-current" : null)"
                       href="/admin/yorumlar"
                       aria-current="@(section == "Reviews" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                        <span>Yorumlar</span>
                    </a>
                    <a class="admin-nav__link @(section == "Kvkk" ? "is-current" : null)"
                       href="/admin/kvkk"
                       aria-current="@(section == "Kvkk" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                        <span>KVKK</span>
                    </a>
                    <a class="admin-nav__link @(section == "Audit" ? "is-current" : null)"
                       asp-area="Admin" asp-controller="Audit" asp-action="Index"
                       aria-current="@(section == "Audit" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                        <span>Denetim</span>
                    </a>
                    <a class="admin-nav__link @(section == "Auth" ? "is-current" : null)"
                       asp-area="Admin" asp-controller="Auth" asp-action="ChangePassword"
                       aria-current="@(section == "Auth" ? "page" : null)">
                        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <span>Parola</span>
                    </a>
                </nav>
                <form class="admin-rail__exit" asp-area="Admin" asp-controller="Auth" asp-action="Logout" method="post">
                    <span class="admin-rail__who">@User.Identity!.Name</span>
                    <button class="btn btn--ghost" type="submit">
                        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                        <span>Çıkış</span>
                    </button>
                </form>
            </header>
            <main class="admin-main" id="main">
                @RenderBody()
            </main>
        </div>
        <footer class="admin-footer admin-footer--shell">
            <span>HerYerde yönetim, @DateTime.UtcNow.Year</span>
            <a class="footer-link" asp-area="" asp-controller="Home" asp-action="Index">Vitrini gör</a>
        </footer>
    }
    else
    {
        <header class="gate-header">
            <a class="wordmark" href="/" aria-label="HerYerde ana sayfa">HerYerde</a>
            <span class="site-header__meta">Yönetim</span>
        </header>
        <main class="admin-main admin-main--bare" id="main">
            @RenderBody()
        </main>
        <footer class="admin-footer">
            <span>HerYerde yönetim, @DateTime.UtcNow.Year</span>
        </footer>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
