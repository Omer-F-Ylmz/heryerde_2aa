@using HerYerde.Entities.Enums
@model ProductFormViewModel

<div class="field">
    <label class="field__label" asp-for="Name"></label>
    <input class="field__input" asp-for="Name" autocomplete="off" />
    @if (Model.SuggestedName is { } suggested)
    {
        <p class="field__hint field__hint--inline">Önerilen yazım: <strong class="field__hint-value">@suggested</strong> — cümle düzeni; marka ve kısaltmalar büyük kalır.</p>
    }
    <span class="field__error" asp-validation-for="Name"></span>
</div>

<div class="field">
    <label class="field__label" asp-for="Description"></label>
    <textarea class="field__input field__input--area" asp-for="Description" rows="5"></textarea>
    <span class="field__error" asp-validation-for="Description"></span>
</div>

<div class="field-row">
    <div class="field">
        <label class="field__label" asp-for="CategoryId"></label>
        <select class="field__input" asp-for="CategoryId">
            <option value="">Kategori seçin</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
            }
        </select>
        <span class="field__error" asp-validation-for="CategoryId"></span>
    </div>

    <div class="field">
        <label class="field__label" asp-for="Price"></label>
        <input class="field__input" asp-for="Price" type="number" step="0.01" min="0" inputmode="decimal" />
        <span class="field__error" asp-validation-for="Price"></span>
    </div>
</div>

<div class="field">
    <label class="field__label" asp-for="Dimensions"></label>
    <input class="field__input" asp-for="Dimensions" autocomplete="off" placeholder="70x70 cm" />
    <span class="field__hint">Yalnız ürün sayfasında "Ölçü" satırı olarak görünür.</span>
    <span class="field__error" asp-validation-for="Dimensions"></span>
</div>

<fieldset class="fieldset">
    <legend class="fieldset__legend">Kampanya</legend>
    <p class="fieldset__note">Kampanya fiyatı normal fiyattan küçük olmalı. Bitiş anı geçtiğinde etiket kendiliğinden düşer.</p>
    <div class="field-row field-row--three">
        <div class="field">
            <label class="field__label" asp-for="CampaignPrice"></label>
            <input class="field__input" asp-for="CampaignPrice" type="number" step="0.01" min="0" inputmode="decimal" />
            <span class="field__error" asp-validation-for="CampaignPrice"></span>
        </div>
        <div class="field">
            <label class="field__label" asp-for="CampaignLabel"></label>
            <input class="field__input" asp-for="CampaignLabel" autocomplete="off" placeholder="Çeyiz indirimi" />
            <span class="field__error" asp-validation-for="CampaignLabel"></span>
        </div>
        <div class="field">
            <label class="field__label" asp-for="CampaignEndsAt"></label>
            <input class="field__input" asp-for="CampaignEndsAt" type="datetime-local" value="@(Model.CampaignEndsAt?.ToString("yyyy-MM-ddTHH:mm"))" />
            <span class="field__error" asp-validation-for="CampaignEndsAt"></span>
        </div>
    </div>
</fieldset>

@if (!Model.RequiresVariants)
{
    <div class="field-row">
        <div class="field">
            <label class="field__label" asp-for="Stock"></label>
            <input class="field__input" asp-for="Stock" type="number" min="0" step="1" inputmode="numeric" />
            @if (Model.Variants.Count > 0)
            {
                <span class="field__hint" data-variant-stock-warning>Bu ürün varyantlı: stok varyantlarda tutulur, bu alanı boş bırakın.</span>
            }
            else
            {
                <span class="field__hint">Boş bırakılırsa stok takibi yapılmaz; 0 yazılırsa vitrinde "Tükendi" görünür. Varyant eklenecekse boş bırakın.</span>
            }
            <span class="field__error" asp-validation-for="Stock"></span>
        </div>
    </div>
}

<fieldset class="fieldset">
    <legend class="fieldset__legend">Varyant eksenleri</legend>
    <p class="fieldset__note">Vitrindeki seçici başlıkları; boş bırakılırsa Beden ve Renk yazılır (ör. Boy, Desen, Ölçü).</p>
    <div class="field-row">
        <div class="field">
            <label class="field__label" asp-for="VariantAxis1Label"></label>
            <input class="field__input" asp-for="VariantAxis1Label" autocomplete="off" placeholder="Beden" />
            <span class="field__error" asp-validation-for="VariantAxis1Label"></span>
        </div>
        <div class="field">
            <label class="field__label" asp-for="VariantAxis2Label"></label>
            <input class="field__input" asp-for="VariantAxis2Label" autocomplete="off" placeholder="Renk" />
            <span class="field__error" asp-validation-for="VariantAxis2Label"></span>
        </div>
    </div>
</fieldset>

<fieldset class="fieldset">
    <legend class="fieldset__legend">1 alana 1 hediye</legend>
    <p class="fieldset__note">Hediye yalnız kampanya bitiş anına kadar geçerlidir. Rozet metni kampanya etiketinden gelir.</p>
    <div class="field-row field-row--three">
        <div class="field">
            <label class="field__label" asp-for="GiftMode"></label>
            <select class="field__input" asp-for="GiftMode">
                <option value="0" selected="@(Model.GiftMode == GiftMode.Yok)">Yok</option>
                <option value="1" selected="@(Model.GiftMode == GiftMode.AyniUrun)">Aynı üründen</option>
                <option value="2" selected="@(Model.GiftMode == GiftMode.BaskaUrun)">Başka üründen</option>
            </select>
            <span class="field__error" asp-validation-for="GiftMode"></span>
        </div>
        <div class="field">
            <label class="field__label" asp-for="GiftProductId"></label>
            <select class="field__input" asp-for="GiftProductId">
                <option value="">Ürün seçin</option>
                @foreach (var gift in Model.GiftProducts)
                {
                    <option value="@gift.Id" selected="@(Model.GiftProductId == gift.Id)">@gift.Name</option>
                }
            </select>
            <span class="field__error" asp-validation-for="GiftProductId"></span>
        </div>
        <div class="field">
            <label class="field__label" asp-for="GiftQty"></label>
            <input class="field__input" asp-for="GiftQty" type="number" min="1" max="99" step="1" inputmode="numeric" />
            <span class="field__error" asp-validation-for="GiftQty"></span>
        </div>
    </div>
</fieldset>

<label class="switch">
    <input asp-for="IsActive" type="checkbox" />
    <span>Yayında</span>
</label>
@if (Model.RequiresVariants)
{
    <p class="field__hint">Giyim alanı: yayına almak için en az bir beden/renk varyantı gerekir.</p>
}
